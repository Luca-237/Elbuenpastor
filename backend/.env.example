# =============================================
# CONFIGURACIÓN DE BASE DE DATOS - MONGODB
# =============================================
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?appName=ElBuenPastor

# =============================================
# CONFIGURACIÓN DE SERVIDOR
# =============================================
PORT=5000
NODE_ENV=development

# =============================================
# CONFIGURACIÓN DE SEGURIDAD
# =============================================
JWT_SECRET=tu_clave_secreta_jwt_aqui
JWT_EXPIRES_IN=7d

# =============================================
# CONFIGURACIÓN WHATSAPP BUSINESS CLOUD API (META)
# =============================================
# Versión de la Graph API de Meta (ej: v19.0)
WHATSAPP_API_VERSION=v19.0

# ID del Número de Teléfono proporcionado en Meta for Developers > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=102938475610293

# ID de la Cuenta de WhatsApp Business (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765

# Token de acceso permanente (System User Access Token con permiso whatsapp_business_messaging)
WHATSAPP_API_TOKEN=EAA...tu_token_aqui...

# Token secreto que tú defines para verificar el Webhook con Meta (debe coincidir con el ingresado en Meta App)
WHATSAPP_VERIFY_TOKEN=ElBuenPastor_WA_VerifyToken_2026

# Número de teléfono del administrador / taller para recibir alertas de nuevos pedidos (formato E.164: 5491140008800)
WHATSAPP_ADMIN_PHONE=5491140008800

# Habilitar auto-respuesta litúrgica en mensajes entrantes (true/false)
WHATSAPP_ENABLE_AUTO_REPLY=true
