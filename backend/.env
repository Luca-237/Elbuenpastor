# =============================================
# CONFIGURACIÓN DE BASE DE DATOS - MONGODB
# =============================================
MONGO_URI=mongodb+srv://elbuenpastorvm_db_user:Dulcearomavm@elbuenpastor.alueqni.mongodb.net/?appName=ElBuenPastor

# =============================================
# CONFIGURACIÓN DE SERVIDOR
# =============================================
PORT=5000
NODE_ENV=development

# =============================================
# CONFIGURACIÓN DE SEGURIDAD
# =============================================
JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_EXPIRES_IN=7d

# =============================================
# CONFIGURACIÓN WHATSAPP BUSINESS CLOUD API (META)
# =============================================
# Versión de la API de Meta Graph (ej: v19.0)
WHATSAPP_API_VERSION=v19.0

# ID del Número de Teléfono registrado en Meta App
WHATSAPP_PHONE_NUMBER_ID=

# ID de la Cuenta de WhatsApp Business (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Token de acceso permanente de Usuario del Sistema (System User Token con permisos whatsapp_business_messaging)
WHATSAPP_API_TOKEN=

# Token secreto para validar el handshake del Webhook con Meta
WHATSAPP_VERIFY_TOKEN=ElBuenPastor_WA_VerifyToken_2026

# Teléfono del Maestro Artesano / Administrador del Taller para recibir alertas de pedidos (formato E.164: 5491140008800)
WHATSAPP_ADMIN_PHONE=5491140008800

# Habilitar auto-respuesta litúrgica en mensajes entrantes (true/false)
WHATSAPP_ENABLE_AUTO_REPLY=true

